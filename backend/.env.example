# Copy to backend/.env and fill in. Never commit the real .env.

# --- Gemini (multi-key rotation, reuse HackRx brain.py pattern) ---
# Comma-separated list of API keys. The client rotates on quota / rate-limit errors.
GEMINI_API_KEYS=key1,key2,key3
# Current GA Flash model. `gemini-flash-latest` also works but has shown ~20s
# cold-start latency; a pinned version keeps live-demo response times ~2s.
GEMINI_MODEL=gemini-3.5-flash

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./data/chroma
CORPUS_CHUNKS_PATH=./data/processed/chunks.jsonl

# Fused-score threshold below which /query forces status="escalate".
# Start conservative; tune during Day 4 spot-checks.
RETRIEVAL_ESCALATE_THRESHOLD=0.35

# Weight of BM25 vs vector score in the fused ranking (0..1, applied to BM25).
HYBRID_BM25_WEIGHT=0.5

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
